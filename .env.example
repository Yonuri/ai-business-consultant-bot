# --- Обязательные ---
BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Telegram ID администраторов через запятую (узнать: @userinfobot)
ADMIN_IDS=123456789

# --- Модели Gemini ---
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
# Размерность вектора. Должна совпадать с уже построенным индексом.
# gemini-embedding-001 поддерживает 768 / 1536 / 3072.
EMBEDDING_DIM=1536
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=1200
# 0 — отключить «размышления» (быстрее и дешевле); -1 — авто.
GEMINI_THINKING_BUDGET=0

# --- RAG ---
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
CHROMA_COLLECTION=company_knowledge

# --- Диалог и лимиты ---
HISTORY_LIMIT=8
QUESTION_COOLDOWN_SECONDS=1.5
QUESTIONS_PER_HOUR=40
MAX_QUESTION_CHARS=1500
MAX_ANSWER_CHARS=3500

# --- Документы ---
MAX_DOCUMENT_BYTES=20971520
MAX_URL_BYTES=5242880
HTTP_TIMEOUT_SECONDS=20

# --- Прочее ---
DATA_DIR=data
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# --- Прокси для Gemini -------------------------------------------------
# Google блокирует Gemini API для российских IP: ошибка
#   "User location is not supported for the API use"
# Укажите здесь прокси с выходом НЕ из России (ЕС, США, Казахстан, Турция).
#
# Форматы (схему можно не писать — подставится автоматически):
#   HTTPS_PROXY=socks5://127.0.0.1:1080     # локальный VPN-клиент (Hiddify, Clash, v2ray)
#   HTTPS_PROXY=127.0.0.1:1080              # то же самое, схема подставится
#   HTTPS_PROXY=http://user:pass@host:port  # платный/корпоративный HTTP-прокси
#
# Проверка перед запуском бота:  python check_proxy.py
# Оставьте пустым, если Gemini доступен напрямую.
HTTPS_PROXY=
